<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are usually plain HTTP on the local network (http://192.168.1.20:8640). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
