{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "server",
  "description": "The server's web app, at whatever address it has: switch server, and update this app.",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["http://*:*", "https://*:*"] },
  "permissions": [
    "allow-switch-server",
    "allow-app-info",
    "allow-check-app-update",
    "allow-install-app-update"
  ]
}
