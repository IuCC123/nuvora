<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri merges this into the app's Info.plist. Servers are usually plain
	     HTTP at any address (a LAN IP, a Tailscale IP, a VPS); without this,
	     macOS stops the window loading them and it sits on "Connecting". -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
