{
  "name": "nuvora",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "gen:api": "cargo run -q -p nuvora-server -- openapi > packages/core/openapi.json && bun run --cwd packages/core gen",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
